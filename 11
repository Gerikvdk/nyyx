WITH Hierarchy AS (
    SELECT 
        Id AS depart_id,
        C_code,
        Parent_id,
        C_name,
        LEVEL AS hierarchy_level
    FROM 
        Bi_view_departs_IBS_tree
    START WITH 
        C_code = :selected_depart_code  -- выбранный код департамента
    CONNECT BY 
        PRIOR Id = Parent_id
),
AccessiblePages AS (
    SELECT DISTINCT 
        p.Page_id,
        p.Page_name
    FROM 
        Bi_portal_map_pages p
    JOIN 
        Bi_acc_depart_pages a ON p.Page_id = a.Page_id
    JOIN 
        Bi_validate_user_dep v ON a.Depart_code LIKE '%' || v.Depart_code || '%'
    WHERE 
        v.LDAP_login IN (SELECT LDAP_login FROM Bi_validate_user_dep WHERE Depart_code IN (SELECT C_code FROM Hierarchy))
)
SELECT 
    ap.Page_id,
    ap.Page_name
FROM 
    AccessiblePages ap
ORDER BY 
    ap.Page_name;
