DECLARE
  v_page_group VARCHAR2(100);
  v_result NUMBER;
BEGIN
  -- Получаем группу текущей страницы
  SELECT PAGE_GROUP 
  INTO v_page_group 
  FROM APEX_APPLICATION_PAGES 
  WHERE APPLICATION_ID = :APP_ID 
    AND PAGE_ID = :APP_PAGE_ID;

  -- Если страница в группе 'user interface', просто завершаем выполнение
  IF v_page_group = 'user interface' THEN
    RETURN;
  END IF;

  -- Если страница не в 'dashboard', сразу перенаправляем на 1020
  IF v_page_group != 'dashboard' THEN
    APEX_UTIL.REDIRECT_URL('f?p=&APP_ID.:1020:&SESSION.');
    RETURN;
  END IF;

  -- Выполняем проверочный запрос, если страница в 'dashboard'
  BEGIN
    SELECT CHECK_AUTH_SEQUENCE(
      p_app_user => :APP_USER,
      p_page_id => :APP_PAGE_ID
    ) INTO v_result FROM DUAL;

    -- Если результат NULL, перенаправляем на 1020
    IF v_result IS NULL THEN
      APEX_UTIL.REDIRECT_URL('f?p=&APP_ID.:1020:&SESSION.');
    END IF;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      APEX_UTIL.REDIRECT_URL('f?p=&APP_ID.:1020:&SESSION.');
  END;
END;