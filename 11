BEGIN
    -- Проверяем, есть ли уже открытая запись для этой сессии и страницы
    DECLARE 
        v_count NUMBER;
    BEGIN
        SELECT COUNT(*) INTO v_count 
        FROM APEX_PAGE_ACCESS_LOG
        WHERE session_id = V('APP_SESSION')
          AND page_id = V('APP_PAGE_ID')
          AND log_status = 'ACTIVE';

        -- Если запись есть, закрываем её, прежде чем создать новую
        IF v_count > 0 THEN
            UPDATE APEX_PAGE_ACCESS_LOG
            SET exit_time = SYSTIMESTAMP, log_status = 'CLOSED'
            WHERE session_id = V('APP_SESSION')
              AND page_id = V('APP_PAGE_ID')
              AND log_status = 'ACTIVE';
            COMMIT;
        END IF;

        -- Создаем новую запись
        INSERT INTO APEX_PAGE_ACCESS_LOG (session_id, user_name, page_id, access_time, log_status)
        VALUES (V('APP_SESSION'), V('APP_USER'), V('APP_PAGE_ID'), SYSTIMESTAMP, 'ACTIVE');
        COMMIT;
    END;
END;