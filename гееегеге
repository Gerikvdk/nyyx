DECLARE
    v_result NUMBER := NULL;
BEGIN
    -- Проверяем ACC_USERS
    BEGIN
        SELECT acc INTO v_result 
        FROM ACC_USERS
        WHERE ROWNUM = 1;

        IF v_result = 0 THEN
            v_result := NULL;
            DBMS_OUTPUT.PUT_LINE('Результат: ' || v_result);
            RETURN;
        ELSIF v_result = 1 THEN
            DBMS_OUTPUT.PUT_LINE('Результат: ' || v_result);
            RETURN;
        END IF;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            v_result := NULL; -- Если нет данных, продолжаем к следующему
    END;

    -- Проверяем ROLE_USERS
    BEGIN
        SELECT acc INTO v_result 
        FROM ROLE_USERS
        WHERE ROWNUM = 1;

        IF v_result = 0 THEN
            v_result := NULL;
            DBMS_OUTPUT.PUT_LINE('Результат: ' || v_result);
            RETURN;
        ELSIF v_result = 1 THEN
            DBMS_OUTPUT.PUT_LINE('Результат: ' || v_result);
            RETURN;
        END IF;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            v_result := NULL;
    END;

    -- Проверяем ROLE_DEPART
    BEGIN
        SELECT acc INTO v_result 
        FROM ROLE_DEPART
        WHERE ROWNUM = 1;

        IF v_result = 0 THEN
            v_result := NULL;
            DBMS_OUTPUT.PUT_LINE('Результат: ' || v_result);
            RETURN;
        ELSIF v_result = 1 THEN
            DBMS_OUTPUT.PUT_LINE('Результат: ' || v_result);
            RETURN;
        END IF;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            v_result := NULL;
    END;

    -- Проверяем DEPART
    BEGIN
        SELECT acc INTO v_result 
        FROM DEPART
        WHERE ROWNUM = 1;

        IF v_result = 0 THEN
            v_result := NULL;
        ELSIF v_result = 1 THEN
            DBMS_OUTPUT.PUT_LINE('Результат: ' || v_result);
            RETURN;
        END IF;

        DBMS_OUTPUT.PUT_LINE('Результат: ' || v_result);
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            v_result := NULL;
            DBMS_OUTPUT.PUT_LINE('Результат: ' || v_result);
    END;
END;