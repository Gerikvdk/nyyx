  BEGIN
    SELECT COUNT(*) INTO v_result 
    FROM your_table_1 
    WHERE your_condition_1;
    
    IF v_result = 1 THEN 
      RETURN 'QUERY_1_SUCCESS'; -- Успех
    ELSIF v_result = 0 THEN 
      RETURN NULL; -- Прерывание
    END IF;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN 
      NULL; -- Продолжить проверку
  END;

  -- Запрос 2
  BEGIN
    SELECT COUNT(*) INTO v_result 
    FROM your_table_2 
    WHERE your_condition_2;
    
    IF v_result = 1 THEN 
      RETURN 'QUERY_2_SUCCESS';
    ELSIF v_result = 0 THEN 
      RETURN NULL;
    END IF;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN 
      NULL;
  END;

  -- Запрос 3
  BEGIN
    SELECT COUNT(*) INTO v_result 
    FROM your_table_3 
    WHERE your_condition_3;
    
    IF v_result = 1 THEN 
      RETURN 'QUERY_3_SUCCESS';
    ELSIF v_result = 0 THEN 
      RETURN NULL;
    END IF;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN 
      NULL;
  END;

  -- Запрос 4
  BEGIN
    SELECT COUNT(*) INTO v_result 
    FROM your_table_4 
    WHERE your_condition_4;
    
    IF v_result = 1 THEN 
      RETURN 'QUERY_4_SUCCESS';
    ELSIF v_result = 0 THEN 
      RETURN NULL;
    END IF;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN 
      NULL;
  END;

  -- Все проверки провалены
  RETURN NULL;
END;