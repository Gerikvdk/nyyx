CREATE OR REPLACE FUNCTION check_auth_sequence (
    p_app_user  IN VARCHAR2,
    p_page_id   IN NUMBER
) RETURN VARCHAR2 
IS
  v_result NUMBER;
BEGIN
  -- Запрос 1 (пример с использованием параметров)
  BEGIN
    SELECT COUNT(*) INTO v_result 
    FROM your_table_1 
    WHERE user_name = p_app_user -- :APP_USER из APEX
      AND page_id = p_page_id;   -- Текущий PAGE_ID

    IF v_result = 1 THEN 
      RETURN 'QUERY_1_SUCCESS'; 
    ELSIF v_result = 0 THEN 
      RETURN NULL; 
    END IF;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN 
      NULL; 
  END;

  -- Аналогично для остальных запросов (Запрос 2, 3, 4)
  -- ...

  RETURN NULL;
END;