window.addEventListener("visibilitychange", function() {
    if (document.visibilityState === "hidden") {
        var formData = new FormData();
        formData.append("P_VISIT_ID", $v("P_VISIT_ID"));

        navigator.sendBeacon("f?p=&APP_ID.:0:&SESSION.:APPLICATION_PROCESS=SAVE_VISIT_TIME", formData);
    }
});