window.addEventListener('beforeunload', function(event) {
    var xhr = new XMLHttpRequest();
    xhr.open("POST", "f?p=&APP_ID.:SAVE_VISIT_TIME:&SESSION.", false); // false = синхронный запрос
    xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");

    var params = "P_VISIT_ID=" + encodeURIComponent($v("P_VISIT_ID"));
    xhr.send(params);

    event.returnValue = ''; // Браузер ждет завершения
});