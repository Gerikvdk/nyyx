create table user_activity_log (
    log_id number generated by default as identity primary key,  -- Идентификатор записи
    user_id varchar2(50),  -- Идентификатор пользователя
    page_id number,        -- Идентификатор страницы
    time_spent number,     -- Время, проведённое на странице (в секундах)
    log_date date          -- Дата и время записи
);







var startTime = new Date().getTime();  // Время начала сессии
var lastActivityTime = startTime;      // Время последней активности

// Функция для отслеживания активности пользователя
function updateActivity() {
    var currentTime = new Date().getTime();
    if (currentTime - lastActivityTime > 60000) { // Если прошло больше минуты без активности
        return; // Не отправлять данные, если бездействие
    }
    var timeSpent = (currentTime - startTime) / 1000; // Время в секундах
    apex.server.process("UPDATE_ACTIVITY_TIME", {
        x01: timeSpent
    });
}

// Периодическое обновление каждые 30 секунд
setInterval(updateActivity, 30000);

// Отслеживаем действия пользователя
document.addEventListener("mousemove", function() {
    lastActivityTime = new Date().getTime();
});
document.addEventListener("keydown", function() {
    lastActivityTime = new Date().getTime();
});

// Обработка выхода пользователя
window.onbeforeunload = function() {
    var endTime = new Date().getTime();
    var timeSpent = (endTime - startTime) / 1000;
    apex.server.process("UPDATE_ACTIVITY_TIME", {
        x01: timeSpent
    });
};








declare
    v_user_id varchar2(50) := :APP_USER;  -- Пользователь APEX
    v_page_id number := :APP_PAGE_ID;     -- ID страницы
    v_time_spent number := :x01;           -- Время, отправленное через JS
begin
    -- Логирование времени активности
    insert into user_activity_log (user_id, page_id, time_spent, log_date)
    values (v_user_id, v_page_id, v_time_spent, sysdate);
end;





var inactivityTimeout = 300000;  // 5 минут
var inactivityTimer;

function resetInactivityTimer() {
    clearTimeout(inactivityTimer);
    inactivityTimer = setTimeout(function() {
        updateActivity();  // Отправляем данные о времени бездействия
    }, inactivityTimeout);
}

document.addEventListener("mousemove", resetInactivityTimer);
document.addEventListener("keydown", resetInactivityTimer);


