declare
    v_user_id varchar2(50) := :APP_USER;  -- Текущий пользователь APEX
    v_page_id number := :APP_PAGE_ID;     -- ID текущей страницы
    v_time_spent number := :x01;          -- Время, переданное из JavaScript
begin
    -- Логирование времени активности с явным указанием формата даты
    insert into user_activity_log (user_id, page_id, time_spent, log_date)
    values (v_user_id, v_page_id, v_time_spent, to_date(sysdate, 'YYYY-MM-DD HH24:MI:SS'));

    -- Корректный JSON-ответ
    htp.p('{"status":"success"}');  
exception
    when others then
        -- Возвращаем JSON с сообщением об ошибке
        htp.p('{"status":"error", "message":"' || sqlerrm || '"}');
end;