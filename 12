/* Сброс базовых отступов и коробочной модели */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Шрифт и цвет фона всей страницы */
body {
  font-family: Arial, sans-serif;
  background-color: #fafafa;
  color: #333;
  
}

/* ====== ШАПКА САЙТА ====== */
.site-header {
  background-color: #28a745; /* Зелёный фон шапки */
  padding: 0.5rem 1rem;      /* Вертикальный и горизонтальный отступы */
}

/* Внутренний контейнер, чтобы ограничить ширину и центрировать контент */
.header-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;        /* Центрируем по вертикали */
  justify-content: space-between; /* Лого слева, меню справа */
}

/* Лого или название портала */
.logo {
  color: #fff;
  font-size: 1.25rem;
  font-weight: bold;
}

/* Горизонтальное меню */
.menu ul {
  display: flex;
  list-style: none;
  gap: 1rem; /* Расстояние между пунктами меню */
}

.menu a {
  color: #fff;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.3s ease;
}
.menu a:hover {
  color: #e0e0e0;
}

/* ====== ЗАГОЛОВОК-Приветствие ====== */
.page-title {
  text-align: center;
  margin: 1rem 0;
  font-size: 1.5rem;
}

/* ====== СЕТКА С КАРТОЧКАМИ ====== */
.container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
  max-width: 1400px;
  margin: 0 auto; /* Центрируем контейнер */
  padding: 1rem;
}

/* Большая зелёная карточка (занимает 2 колонки на широком экране) */
.main-card {
  background-color: #28a745;
  color: #fff;
  padding: 1.5rem;
  border-radius: 0.5rem;
  grid-column: span 2; /* на широком экране растягиваем на 2 столбца */
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Адаптивность: при очень узких экранах убираем растяжение */
@media (max-width: 600px) {
  .main-card {
    grid-column: span 1;
  }
}

/* ====== Обычные карточки ====== */
.card {
  background-color: #fff;
  padding: 1rem;
  border-radius: 0.5rem;
  min-height: 100px;
  box-shadow: 0 0 5px rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;

  /* Плавный переход для анимации при наведении */
  transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
}

/* Небольшой отступ для заголовков в карточках */
.card h3 {
  margin-bottom: 0.5rem;
}

/* Анимация при наведении (лёгкое увеличение, тень, смена фона) */
.card:hover {
  transform: scale(1.05);
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  background-color: #f0f0f0;
}